            "PawVitaFaqs1": {
              "heading": {
                "title": "FAQS",
                "icon": "FaPaw",
                "variant": "decorated"
              },
              "title": "Frequently <span class=\"text-[#00695c]\">Asked Questions</span>",
              "description": "Find answers to common questions about our pet grooming services, bookings, and care procedures.",
              "leftImage": "/other/faq-h.webp",
              "cards": [
                {
                  "id": "faq-card-1",
                  "title": "Safe & Trusted Care",
                  "description": "We use pet-safe products and follow hygienic grooming practices.",
                  "icon": "FaShieldAlt"
                },
                {
                  "id": "faq-card-2",
                  "title": "Experienced Groomers",
                  "description": "Our certified groomers ensure your pets look and feel their best.",
                  "icon": "FaAward"
                }
              ],
              "faqs": [
                {
                  "id": "faq-1",
                  "question": "What is included in a pet grooming session?",
                  "answer": "Our grooming session includes a thorough bath, coat brushing, nail trimming, ear cleaning, paw care, hair trimming or styling, and finishing with pet-safe products to keep your pet fresh and happy."
                },
                {
                  "id": "faq-2",
                  "question": "How often should I groom my pet?",
                  "answer": "It depends on the breed, coat type, and lifestyle of your pet. Generally, professional grooming every 4-6 weeks is recommended to maintain optimal skin and coat health."
                },
                {
                  "id": "faq-3",
                  "question": "Is grooming safe for all pets?",
                  "answer": "Yes, grooming is generally safe and beneficial for most pets. We adapt our techniques to accommodate different breeds, ages, and temperaments to ensure a safe and positive experience."
                },
                {
                  "id": "faq-4",
                  "question": "Do I need to stay with my pet during grooming?",
                  "answer": "We usually recommend dropping off your pet to allow them to focus and build trust with the groomer. However, you are welcome to stay if your pet requires special attention or if you prefer."
                },
                {
                  "id": "faq-5",
                  "question": "What should I do before bringing my pet for grooming?",
                  "answer": "Please ensure your pet has relieved themselves and had a light meal before the appointment. It's also helpful to walk them to release any excess energy."
                }
              ]
            }
          }
        },
